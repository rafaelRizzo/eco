# Ambiente: development | test | production
NODE_ENV=development
PORT=3333
HOST=0.0.0.0
# Nº de proxies na frente da API (Cloudflare + Nginx Proxy Manager = 2), pro rate limit enxergar o IP real
TRUST_PROXY_HOPS=0
LOG_ENABLED=true
LOG_LEVEL=info

# Postgres no Supabase (Connect > Session pooler, porta 5432, funciona em IPv4 e com prepared statements).
# Troque [PROJECT-REF], [SENHA] e a região. sslmode=require é obrigatório no Supabase.
DATABASE_URL=postgres://postgres.[PROJECT-REF]:[SENHA]@aws-0-[REGIAO].pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_POOL_MAX=10

# Auth - gere com: openssl rand -hex 32
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# Bootstrap: token pra criar o primeiro super admin em POST /setup (tela /setup no front).
# Gere com: openssl rand -hex 24. Depois do setup ele não serve pra mais nada.
SETUP_TOKEN=change-me
# true: qualquer um cria conta em /register (depois do setup). false: só o super admin cria usuários.
ALLOW_PUBLIC_SIGNUP=true

# Origem(ns) do frontend, separadas por vírgula
CORS_ORIGIN=http://localhost:5173

# Crons
APP_TIMEZONE=America/Sao_Paulo
JOBS_ENABLED=true
JOBS_RUN_ON_BOOT=true
# Dias de antecedência pra gerar lançamento de recorrência (mensalidade) antes do vencimento
RECURRING_LEAD_DAYS=5
# Dias de antecedência pra avisar conta/fatura a vencer
REMINDER_DAYS_BEFORE=3
